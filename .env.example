WHAXON_MSF_SSL=0
WHAXON_MSF_USER=msf
WHAXON_MSF_PASS=test123
WHAXON_MSF_HOST=127.0.0.1
WHAXON_MSF_PORT=55553
WHAXON_MSF_AUTOCHAIN=0

# Legacy JobStore auto-drain is disabled by default. Enable only to resume the
# compatibility worker for legacy pending jobs; V2 runs use the durable V2 worker.
# WHAXON_LEGACY_QUEUE_DRAIN_ENABLED=false

WHAXON_LAB_TARGET=172.28.0.10
WHAXON_LAB_LHOST=172.28.0.1
WHAXON_LAB_SUBNET=172.28.0.0/16

WHAXON_AUTH_USER=whaxon
WHAXON_AUTH_PASS=whaxon


# The WHAXON_LAB_* values above describe the lab topology written by
# whaxon init. WHAXON itself does not read them; they are exposed here
# so your own scripts (docker exec, ssh, curl) can source the same
# values without hardcoding IPs.
